# Copy to .env for local overrides. Never commit the real .env.

# Generate a strong key for production, e.g.:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=dev-insecure-key-change-me-in-production-0123456789abcdef

# Turn OFF in production.
DEBUG=True

# Comma-separated hostnames allowed to serve the app in production.
ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated https origins, e.g. https://your-app.example.com
CSRF_TRUSTED_ORIGINS=

# Enable only behind a trusted reverse proxy that manages X-Forwarded-For.
TRUST_X_FORWARDED_FOR=False
# Optional trusted hops, evaluated right-to-left (comma-separated CIDRs).
# Configure your CDN/proxy ranges rather than trusting a client-supplied
# leftmost address.
TRUSTED_PROXY_CIDRS=

# IANA time zone used for "due today" and streak calculations.
TIME_ZONE=America/Los_Angeles

# Production PostgreSQL connection URL.
# DATABASE_URL=postgresql://user:password@host:5432/database

# Optional: absolute path for the SQLite database file.
# DATABASE_PATH=/data/db.sqlite3

# Optional DeepL French → English translation for the translate panel.
# When set, DeepL is asked first (through this server) and on-device
# translation is the fallback. Keys ending in ":fx" use the free API host.
# DEEPL_API_KEY=
# EN-GB (default, "colour") or EN-US ("color").
# DEEPL_TARGET_LANG=EN-GB

# Optional LibreTranslate-compatible fallback, used only when DEEPL_API_KEY is
# unset and the browser has no on-device Translator API. Leave both empty and
# no selected text ever leaves your server; the app offers DeepL and Google
# Translate links instead.
# TRANSLATION_API_URL=https://libretranslate.example.com/translate
# TRANSLATION_API_KEY=
# TRANSLATION_TIMEOUT=8

# EO3 response narration player (default True).
EO3_AUDIO_ENABLED=True
# Legacy gate for the one-off Culture p1 trial recording (default True).
EO3_AUDIO_SAMPLE_ENABLED=True
# Natural voice for French read-aloud; False uses the device voice (default True).
FRENCH_AUDIO_ENABLED=True
# ElevenLabs spending switch: False stops all NEW paid generation; existing
# audio still plays. Production defaults to True; kept off locally.
FRENCH_AUDIO_GENERATION_ENABLED=False
# Lifetime character ceiling, including failed/uncertain provider attempts.
# Production defaults to 5000000; 0 blocks generation locally.
FRENCH_AUDIO_CHARACTER_BUDGET=0
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
